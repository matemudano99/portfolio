---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Mateo Mudano">
  <section
    style="min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:40px"
  >
    <p style="margin:0;font-weight:700;font-size:clamp(48px,12vw,120px);letter-spacing:-.05em;color:var(--a)">
      404
    </p>
    <p style="margin:0;font-size:13px;color:#5f6673">// page not found · página no encontrada</p>
    <a
      href="/"
      class="dc-linkbtn"
      style="margin-top:8px;font-size:12px;padding:11px 16px;border:1px solid rgba(255,255,255,.12);border-radius:3px;background:#10131a"
      >← index.kt</a
    >
  </section>
</BaseLayout>
